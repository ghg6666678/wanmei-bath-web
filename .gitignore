# 本地账号票据与个人信息，绝不提交
config.json
login_raw.json
pending_login.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 运行产物
*.log

# 版本检查缓存（运行时生成）
version_cache.json

# 上游请求元数据日志（vwater._event 生成，只有路径/状态码/长度，无用户数据）
events.log

# 无状态模式的会话密钥（本地生成，绝不提交）
state.key

# 合并部署时从安卓仓库 site/ 复制来的官网快照（发版时重新生成，不入库）
site/

# 静态资源构建产物（build-assets.mjs 生成，不入库）
cloudflare/public/

# wrangler 本地缓存与临时文件（含账号信息）
cloudflare/.wrangler/
.wrangler/
